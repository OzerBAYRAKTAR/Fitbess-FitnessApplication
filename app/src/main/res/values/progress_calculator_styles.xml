<resources>
 <color name="pc_cream">#FAF8F0</color><color name="pc_forest">#133F31</color><color name="pc_lime">#C9ED8C</color><color name="pc_border">#DFE7DC</color>
 <style name="PcTitle" parent="FitTitle"><item name="android:textSize">30sp</item><item name="android:fontFamily">sans-serif-black</item><item name="android:textColor">@color/pc_forest</item></style>
 <style name="PcSection" parent="FitSection"><item name="android:textSize">20sp</item><item name="android:textColor">@color/pc_forest</item></style>
 <style name="PcBody" parent="FitBody"><item name="android:textSize">14sp</item><item name="android:lineSpacingExtra">2dp</item></style>
 <style name="PcCard"><item name="android:background">@drawable/pc_card</item><item name="android:padding">20dp</item></style>
 <style name="PcInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
  <item name="boxBackgroundColor">@color/white</item><item name="boxCornerRadiusTopStart">16dp</item><item name="boxCornerRadiusTopEnd">16dp</item><item name="boxCornerRadiusBottomStart">16dp</item><item name="boxCornerRadiusBottomEnd">16dp</item><item name="android:layout_marginTop">14dp</item>
 </style>
 <style name="PcEdit"><item name="android:minHeight">60dp</item><item name="android:textSize">20sp</item><item name="android:singleLine">true</item><item name="android:inputType">number</item><item name="android:imeOptions">actionNext</item></style>
 <style name="PcPeriod" parent="Widget.MaterialComponents.Button.OutlinedButton">
  <item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item><item name="android:minHeight">48dp</item><item name="android:minWidth">0dp</item><item name="android:paddingStart">8dp</item><item name="android:paddingEnd">8dp</item><item name="cornerRadius">16dp</item><item name="backgroundTint">@color/pc_period_background</item><item name="android:textColor">@color/pc_period_text</item><item name="strokeColor">@color/pc_border</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
 </style>
 <style name="PcSex" parent="Widget.MaterialComponents.CompoundButton.RadioButton"><item name="android:minHeight">52dp</item><item name="android:paddingEnd">12dp</item><item name="android:textSize">16sp</item><item name="android:buttonTint">@color/fit_primary</item></style>
</resources>
