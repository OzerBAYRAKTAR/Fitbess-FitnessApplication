<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="fit_background">#F4F7F5</color>
    <color name="fit_primary">#167348</color>
    <color name="fit_splash_background">#104E38</color>
    <color name="fit_text">#172B23</color>
    <color name="fit_muted">#5F6F65</color>
    <color name="fit_soft">#E5F1E9</color>
    <color name="fit_amber">#F9EACB</color>
    <color name="fit_border">#DEE7E1</color>
    <dimen name="fit_screen_padding">24dp</dimen>
    <dimen name="fit_space_small">8dp</dimen>
    <dimen name="fit_space">16dp</dimen>
    <dimen name="fit_space_large">24dp</dimen>
    <style name="FitTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/fit_text</item>
    </style>
    <style name="FitSection">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/fit_text</item>
    </style>
    <style name="FitBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/fit_muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="FitCaption" parent="FitBody">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="FitCard">
        <item name="android:background">@drawable/fit_card</item>
        <item name="android:padding">@dimen/fit_space</item>
    </style>
    <style name="FitButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/fit_button_background</item>
        <item name="android:textColor">@color/fit_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="FitAction" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/fit_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconTint">@color/fit_primary</item>
        <item name="iconPadding">16dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
