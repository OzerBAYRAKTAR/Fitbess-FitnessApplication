<resources>
    <style name="HomeCardTitle" parent="FitTitle">
        <item name="android:textSize">23sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>
    <style name="HomeCardBody" parent="FitBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/home_ink</item>
    </style>
    <style name="HomeAction" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/home_ink</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="elevation">0dp</item>
        <item name="icon">@drawable/home_arrow</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconTint">@color/home_ink</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
    </style>
    <style name="HomeNavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="HomeNavLabel.Active" parent="HomeNavLabel">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
