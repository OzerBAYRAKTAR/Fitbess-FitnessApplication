<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fit_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fit_screen_padding">
        <TextView
            style="@style/FitTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile"/>
        <TextView
            style="@style/FitBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_subtitle"/>
        <TextView
            style="@style/FitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_reminders"/>
        <LinearLayout
            style="@style/FitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/waterReminderSwitch"
                style="@style/FitBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/water_reminder"
                android:textColor="@color/fit_text"/>
            <TextView
                android:id="@+id/waterStatus"
                style="@style/FitCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fit_space"
                android:text="@string/reminder_off"
                android:minHeight="48dp"
                android:gravity="center_vertical"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/notificationSwitch"
                style="@style/FitBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/motivation_title"
                android:textColor="@color/fit_text"/>
            <TextView
                android:id="@+id/motivationStatus"
                style="@style/FitCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fit_space"
                android:text="@string/reminder_off"
                android:minHeight="48dp"
                android:gravity="center_vertical"/>
            <TextView
                android:id="@+id/profileError"
                style="@style/FitCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fit_space"
                android:text="@string/profile_save_error"
                android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/notificationSettings"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notification_settings"/>
        </LinearLayout>
        <TextView
            style="@style/FitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_preferences"/>
        <LinearLayout
            style="@style/FitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/consLanguage"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/languages"
                app:icon="@drawable/fit_globe"/>
        </LinearLayout>
        <TextView
            style="@style/FitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_support"/>
        <LinearLayout
            style="@style/FitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/consRateus"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rateus"
                app:icon="@drawable/fit_star"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/consShare"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shareus"
                app:icon="@drawable/fit_share"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/consPrivacy"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy"
                app:icon="@drawable/fit_info"/>
        </LinearLayout>
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-1896269552628731/8170906506"/>
    </LinearLayout>
</ScrollView>
