<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fit_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fit_screen_padding">
        <TextView
            style="@style/FitTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile"/>
        <TextView
            style="@style/FitBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_subtitle"/>
        <TextView
            style="@style/FitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_reminders"/>
        <LinearLayout
            style="@style/FitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/fit_soft_card"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:src="@drawable/fit_water_drop"
                        app:tint="@color/fit_primary" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/waterReminderSwitch"
                        style="@style/FitBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/water_reminder"
                        android:textColor="@color/fit_text" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/waterStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/fit_background"
                    android:gravity="center_vertical|start"
                    android:minHeight="44dp"
                    android:textColor="@color/fit_text"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/fit_expand_more"
                    app:iconGravity="textEnd"
                    app:iconTint="@color/fit_primary" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/fit_soft_card"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:src="@drawable/fit_dumbbell"
                        app:tint="@color/fit_primary" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/notificationSwitch"
                        style="@style/FitBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/motivation_title"
                        android:textColor="@color/fit_text" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/motivationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/fit_background"
                    android:gravity="center_vertical|start"
                    android:minHeight="44dp"
                    android:textColor="@color/fit_text"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/fit_expand_more"
                    app:iconGravity="textEnd"
                    app:iconTint="@color/fit_primary" />
            </LinearLayout>
            <TextView
                android:id="@+id/notificationGuidance"
                style="@style/FitCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fit_notification_callout"
                android:padding="12dp"
                android:text="@string/notification_blocked"
                android:visibility="gone" />
            <TextView
                android:id="@+id/profileError"
                style="@style/FitCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fit_space"
                android:text="@string/profile_save_error"
                android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/notificationSettings"
                style="@style/FitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/notification_settings"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            style="@style/FitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_purchases"/>
        <LinearLayout
            style="@style/FitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <TextView
                style="@style/FitSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remove_ads"/>
            <TextView
                android:id="@+id/adFreeDescription"
                style="@style/FitBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fit_space"
                android:text="@string/remove_ads_description"/>
            <TextView
                android:id="@+id/adFreeStatus"
                style="@style/FitCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fit_space"
                android:text="@string/remove_ads_unavailable"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buyAdFree"
                style="@style/FitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fit_space"
                android:text="@string/view_ad_free_offer"/>
        </LinearLayout>
        <TextView
            style="@style/FitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_preferences"/>
        <LinearLayout
            style="@style/FitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/consLanguage"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/languages"
                app:icon="@drawable/fit_globe"/>
        </LinearLayout>
        <TextView
            style="@style/FitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fit_space"
            android:text="@string/profile_support"/>
        <LinearLayout
            style="@style/FitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/consRateus"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rateus"
                app:icon="@drawable/fit_star"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/consShare"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shareus"
                app:icon="@drawable/fit_share"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/consPrivacy"
                style="@style/FitAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy"
                app:icon="@drawable/fit_info"/>
        </LinearLayout>
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:adSize="BANNER"
            app:adUnitId="@string/ad_banner_profile"/>
    </LinearLayout>
</ScrollView>
