<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fit_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/brand" style="@style/FitTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/brand_short"/>
        <TextView android:id="@+id/tagline" style="@style/FitBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/brand_tagline"/>
        <Space android:layout_width="1dp" android:layout_height="64dp"/>
        <TextView android:id="@+id/welcomeTitle" style="@style/FitTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/welcome_title"/>
        <TextView android:id="@+id/welcomeBody" style="@style/FitBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/welcome_body"/>
        <TextView android:id="@+id/welcomePrivacy" style="@style/FitBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/welcome_privacy"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/beginTraining" style="@style/FitButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/begin_training"/>
    </LinearLayout>
</ScrollView>
