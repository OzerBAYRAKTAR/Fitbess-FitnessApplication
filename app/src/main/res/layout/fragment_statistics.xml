<?xml version="1.0" ?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/progressScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/pc_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="32dp" android:layout_height="40dp" android:src="@drawable/home_leaf" android:importantForAccessibility="no"/>
            <TextView style="@style/AcBrand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ac_brand" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView style="@style/PcTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ac_progress" android:id="@+id/progressTitle" android:layout_marginTop="14dp"/>
        <TextView style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ac_progress_subtitle" android:layout_marginTop="4dp"/>
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/periodGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/periodSeven">
            <com.google.android.material.button.MaterialButton android:id="@+id/periodSeven" style="@style/PcPeriod" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/pc_period_seven"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/periodFourWeeks" style="@style/PcPeriod" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/pc_period_four"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ac_hero" android:clipToOutline="true" android:padding="20dp" android:layout_marginTop="16dp">
            <TextView style="@style/PcSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ac_effort" android:id="@+id/weekTitle" android:textColor="@color/white"/>
            <TextView android:id="@+id/periodDate" style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DCE9DC" android:layout_marginTop="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/weekMinutes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="68sp" android:fontFamily="sans-serif-black" android:textColor="@color/ac_lime" android:importantForAccessibility="yes"/>
                <TextView style="@style/PcSection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="@string/pc_minutes" android:textColor="@color/white"/>
                <ImageView android:layout_width="48dp" android:layout_height="60dp" android:src="@drawable/ac_runner" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#648E7C" android:layout_marginBottom="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="6dp">
                    <ImageView android:layout_width="30dp" android:layout_height="34dp" android:padding="5dp" android:src="@drawable/ac_weights" android:background="@drawable/ac_icon_background" android:importantForAccessibility="no" app:tint="@color/white" android:layout_marginEnd="8dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp">
                        <TextView android:id="@+id/weekWorkouts" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="28sp" android:fontFamily="sans-serif-black" android:textColor="@color/white"/>
                        <TextView style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pc_workouts" android:textColor="@color/white" android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="6dp">
                    <ImageView android:layout_width="30dp" android:layout_height="34dp" android:padding="5dp" android:src="@drawable/ac_layers" android:background="@drawable/ac_icon_background" android:importantForAccessibility="no" app:tint="@color/white" android:layout_marginEnd="8dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp">
                        <TextView android:id="@+id/weekMoves" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="28sp" android:fontFamily="sans-serif-black" android:textColor="@color/white"/>
                        <TextView style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pc_moves" android:textColor="@color/white" android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pc_partial_note" android:layout_marginTop="8dp" android:textSize="12sp"/>
        <LinearLayout style="@style/PcCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">
            <TextView android:id="@+id/chartTitle" style="@style/PcSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pc_daily_activity"/>
            <TextView android:id="@+id/chartCaption" style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/pc_daily_unit"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginTop="12dp">
                <com.bayraktar.healthybackandneck.ui.Statistics.ActivityChartGrid android:id="@+id/chartGrid" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="30dp" android:fillViewport="true" android:scrollbars="none">
                    <LinearLayout android:id="@+id/weekBars" android:layout_width="wrap_content" android:minWidth="0dp" android:layout_height="208dp" android:orientation="horizontal"/>
                </HorizontalScrollView>
            </FrameLayout>
            <TextView android:id="@+id/chartSelection" style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/pc_soft" android:accessibilityLiveRegion="polite"/>
            <TextView android:id="@+id/chartEmpty" style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/pc_no_activity" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/programProgress" style="@style/PcCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <FrameLayout android:layout_width="100dp" android:layout_height="100dp">
                    <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/programRing" android:layout_width="100dp" android:layout_height="100dp" android:indeterminate="false" android:max="21" app:indicatorSize="94dp" app:trackThickness="8dp" app:indicatorColor="@color/ac_lime" app:trackColor="@color/pc_border" app:trackCornerRadius="4dp"/>
                    <TextView android:id="@+id/programCount" style="@style/PcSection" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="22sp"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView style="@style/PcSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ac_journey"/>
                    <TextView android:id="@+id/programDescription" style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <Spinner android:id="@+id/programLevel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:background="@drawable/pc_soft"/>
            <TextView style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pc_program_note" android:textSize="12sp" android:layout_marginTop="8dp"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/openCalculators" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="76dp" android:padding="16dp" android:text="@string/ac_discover" android:textAllCaps="false" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pc_forest" android:backgroundTint="@color/fit_soft" app:icon="@drawable/pc_bmi" app:iconTint="@color/pc_forest" app:cornerRadius="22dp"/>
        <TextView style="@style/PcSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pc_recent" android:layout_marginTop="24dp"/>
        <TextView android:id="@+id/emptyHistory" style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/history_empty"/>
        <LinearLayout android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/showMore" style="@style/FitAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/show_more"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
