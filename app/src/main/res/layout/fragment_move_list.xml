<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fit_background"
    android:padding="@dimen/fit_screen_padding">
    <TextView
        android:id="@+id/favoritesTitle"
        style="@style/FitTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_favorites"/>
    <TextView
        android:id="@+id/favoritesSubtitle"
        style="@style/FitBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/favorites_subtitle"
        android:layout_marginTop="8dp"/>
    <TextView
        android:id="@+id/favoriteCount"
        style="@style/FitSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_favorites"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:id="@+id/txtEmptyFav"
        style="@style/FitBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fit_card"
        android:padding="24dp"
        android:text="@string/favorite_description"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheck"
        style="@style/FitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/exercices"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvdaydetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>
</LinearLayout>
