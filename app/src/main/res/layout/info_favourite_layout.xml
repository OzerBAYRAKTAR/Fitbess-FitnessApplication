<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/exerciseFavouriteTitle" style="@style/PcSection" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <pl.droidsonroids.gif.GifImageView android:id="@+id/infoFavouriteGif" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginVertical="12dp" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/exerciseFavouriteDescription" style="@style/PcBody" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
