<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="@color/white" app:cardElevation="2dp" app:strokeWidth="1dp" app:strokeColor="@color/pc_border" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical">
        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/favoriteImage" android:layout_width="112dp" android:layout_height="140dp" android:scaleType="fitCenter" android:background="@drawable/pc_soft" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/roundedImageStyletwenty"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/favoriteName" style="@style/PcSection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="18sp"/>
                <ImageButton android:id="@+id/deleteBtn" android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/fs_heart_filled" app:tint="@color/pc_forest" android:contentDescription="@string/remove_favorite"/>
            </LinearLayout>
            <TextView android:id="@+id/favoriteCategory" style="@style/PcBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/pc_soft" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:textSize="12sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/inspectFavorite" style="@style/FitButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="48dp" android:text="@string/fs_inspect" android:textSize="14sp" android:backgroundTint="@color/pc_forest" app:cornerRadius="16dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
