<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fit_background" android:fillViewport="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView style="@style/FitSection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/brand_short" android:textColor="@color/fit_primary" android:textStyle="bold"/>
 </LinearLayout>
 <TextView style="@style/FitTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/discovery_greeting" android:textSize="27sp" android:lineSpacingExtra="2dp"/>
 <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#F0EFE9">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="180dp">
    <ImageView android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:src="@drawable/home_training_hero" android:scaleType="centerCrop" android:contentDescription="@null"/>
    <View android:layout_width="190dp" android:layout_height="0dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:background="@drawable/discovery_hero_scrim"/>
    <LinearLayout android:layout_width="165dp" android:layout_height="wrap_content" android:minHeight="180dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:padding="18dp" android:gravity="center_vertical" android:orientation="vertical">
     <TextView style="@style/FitCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/discovery_program_badge" android:textColor="@color/fit_primary" android:textStyle="bold"/>
     <TextView style="@style/FitTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/discovery_program_title" android:textSize="23sp"/>
    </LinearLayout>
   </androidx.constraintlayout.widget.ConstraintLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
    <TextView android:id="@+id/heroContext" style="@style/FitBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/discovery_new_program" android:textColor="@color/fit_text"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/heroAction" style="@style/FitButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/start_now"/>
   </LinearLayout>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:baselineAligned="false">
  <com.google.android.material.button.MaterialButton android:id="@+id/programBeginner" style="@style/DiscoveryLevelChip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/discovery_level_beginner" android:contentDescription="@string/hometitle1"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/programIntermediate" style="@style/DiscoveryLevelChip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="5dp" android:text="@string/discovery_level_intermediate" android:contentDescription="@string/hometitle2"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/programAdvanced" style="@style/DiscoveryLevelChip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/discovery_level_advanced" android:contentDescription="@string/hometitle3"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView style="@style/FitSection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/discovery_choose_region"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/allRegions" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/discovery_all" android:textColor="@color/fit_primary"/>
 </LinearLayout>
 <GridLayout android:id="@+id/regionGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:layout_marginTop="8dp"/>
 <TextView style="@style/FitSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/discovery_more"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/warmupAction" style="@style/DiscoveryLevelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/region_warmup"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/breathAction" style="@style/DiscoveryLevelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/discovery_breath"/>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
