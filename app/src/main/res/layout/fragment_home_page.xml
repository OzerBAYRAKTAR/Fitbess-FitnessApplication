<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/home_cream" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="10dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/homeHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="240dp">
            <ImageView android:id="@+id/headerPhoto" android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/home_header_photo" android:scaleType="centerCrop" android:contentDescription="@null" android:importantForAccessibility="no" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
            <androidx.constraintlayout.widget.Guideline android:id="@+id/headerSplit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.57"/>
            <LinearLayout android:id="@+id/headerCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="8dp" android:paddingTop="20dp" android:paddingBottom="32dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/headerSplit" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <TextView android:id="@+id/homeBrand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_brand_title" android:textColor="@color/home_ink" android:textSize="19sp" android:textStyle="bold" app:drawableStartCompat="@drawable/home_leaf" android:drawablePadding="8dp" android:gravity="center_vertical"/>
                <TextView android:id="@+id/homeMotivation" style="@style/FitTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="@string/home_motivation" android:textColor="@color/home_ink" android:textSize="27sp" android:lineSpacingExtra="1dp"/>
                <TextView android:id="@+id/homeSubtitle" style="@style/HomeCardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/home_intro" android:textSize="16sp"/>
                <View android:layout_width="42dp" android:layout_height="4dp" android:layout_marginTop="18dp" android:background="@drawable/home_accent_line"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.card.MaterialCardView android:id="@+id/programCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" app:cardCornerRadius="24dp" app:cardElevation="3dp" app:cardBackgroundColor="@color/home_forest" app:strokeWidth="1dp" app:strokeColor="@color/home_gold">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="194dp">
                <ImageView android:id="@+id/programPhoto" android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/home_program_photo" android:scaleType="centerCrop" android:contentDescription="@null" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                <androidx.constraintlayout.widget.Guideline android:id="@+id/programSplit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.69"/>
                <FrameLayout android:id="@+id/programIcon" android:layout_width="56dp" android:layout_height="68dp" android:layout_marginStart="14dp" android:layout_marginTop="27dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" android:importantForAccessibility="noHideDescendants">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/home_calendar" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="17dp" android:gravity="center" android:text="21" android:textColor="@color/home_cream" android:textSize="29sp" android:textStyle="bold"/>
                </FrameLayout>
                <LinearLayout android:id="@+id/programCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="82dp" android:layout_marginTop="20dp" android:layout_marginEnd="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/programSplit" app:layout_constraintTop_toTopOf="parent">
                    <TextView android:id="@+id/programTitle" style="@style/HomeCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_program_title" android:textColor="@color/home_cream"/>
                    <TextView android:id="@+id/heroContext" style="@style/HomeCardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_program_description" android:textColor="@color/home_cream"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/heroAction" style="@style/HomeAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="14dp" android:layout_marginEnd="8dp" android:layout_marginBottom="20dp" android:text="@string/home_program_action" app:backgroundTint="@color/home_gold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/programSplit" app:layout_constraintTop_toBottomOf="@id/programCopy" app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/regionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="12dp" app:cardCornerRadius="24dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/home_cream" app:strokeWidth="1dp" app:strokeColor="#FFFFFF">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="166dp">
                <ImageView android:id="@+id/regionPhoto" android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/home_region_photo" android:scaleType="centerCrop" android:contentDescription="@null" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                <androidx.constraintlayout.widget.Guideline android:id="@+id/regionCardSplit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.69"/>
                <ImageView android:id="@+id/regionIcon" android:layout_width="54dp" android:layout_height="118dp" android:layout_marginStart="14dp" android:src="@drawable/home_body" android:contentDescription="@null" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                <LinearLayout android:id="@+id/regionCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="82dp" android:layout_marginTop="18dp" android:layout_marginEnd="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/regionCardSplit" app:layout_constraintTop_toTopOf="parent">
                    <TextView android:id="@+id/regionCardTitle" style="@style/HomeCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_region_title" android:textColor="@color/home_ink"/>
                    <TextView android:id="@+id/regionDescription" style="@style/HomeCardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/home_region_description"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/allRegions" style="@style/HomeAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="82dp" android:layout_marginTop="12dp" android:layout_marginEnd="8dp" android:layout_marginBottom="18dp" android:text="@string/home_region_action" app:backgroundTint="@color/home_sage" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/regionCardSplit" app:layout_constraintTop_toBottomOf="@id/regionCopy" app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/wellnessCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="12dp" app:cardCornerRadius="24dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/home_ice" app:strokeWidth="1dp" app:strokeColor="#FFFFFF">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="166dp">
                <ImageView android:id="@+id/wellnessPhoto" android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/home_wellness_photo" android:scaleType="centerCrop" android:contentDescription="@null" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                <androidx.constraintlayout.widget.Guideline android:id="@+id/wellnessSplit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.72"/>
                <ImageView android:id="@+id/wellnessIcon" android:layout_width="56dp" android:layout_height="70dp" android:layout_marginStart="14dp" android:layout_marginTop="30dp" android:src="@drawable/home_breathe" android:contentDescription="@null" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout android:id="@+id/wellnessCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="82dp" android:layout_marginTop="18dp" android:layout_marginEnd="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/wellnessSplit" app:layout_constraintTop_toTopOf="parent">
                    <TextView android:id="@+id/wellnessTitle" style="@style/HomeCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_wellness_title" android:textColor="@color/home_ink" android:textSize="21sp"/>
                    <TextView android:id="@+id/wellnessDescription" style="@style/HomeCardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/home_wellness_description"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/wellnessActions" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginStart="16dp" android:layout_marginTop="12dp" android:layout_marginEnd="8dp" android:layout_marginBottom="18dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/wellnessSplit" app:layout_constraintTop_toBottomOf="@id/wellnessCopy" app:layout_constraintBottom_toBottomOf="parent">
                    <com.google.android.material.button.MaterialButton android:id="@+id/warmupAction" style="@style/HomeAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/home_warmup_action" android:textSize="14sp" android:textColor="#FFFFFF" app:backgroundTint="@color/home_teal" app:iconTint="#FFFFFF"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/breathAction" style="@style/HomeAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/home_breath_action" android:textSize="14sp" app:backgroundTint="#E7F5F8" app:strokeColor="@color/home_teal" app:strokeWidth="1dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
