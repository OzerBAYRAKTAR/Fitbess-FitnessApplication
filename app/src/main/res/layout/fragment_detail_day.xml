<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fit_background"
    android:padding="24dp">
    <TextView
        android:id="@+id/detaildayFirst"
        style="@style/FitTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exercices"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/detaildaySecond"
            style="@style/FitBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_day"/>
        <TextView
            android:id="@+id/txtdaysecond"
            style="@style/FitBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        style="@style/FitCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginVertical="16dp">
        <TextView
            android:id="@+id/txtexercise"
            style="@style/FitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exercices"/>
        <TextView
            android:id="@+id/txttime"
            style="@style/FitBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/time"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/accessStatus"
        style="@style/FitCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/access_loading"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvdaydetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/startExercise"
        style="@style/FitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_available"
        android:layout_marginTop="8dp"/>
</LinearLayout>
