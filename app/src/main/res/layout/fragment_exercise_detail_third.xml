<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/workout_cream">
 <FrameLayout android:layout_width="match_parent" android:layout_height="220dp">
  <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/workout_program_hero" android:scaleType="centerCrop" android:contentDescription="@null"/>
  <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/workout_hero_scrim"/>
  <ImageView android:id="@+id/imageBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="12dp" android:padding="12dp" android:src="@drawable/ic_arrow_back_aligned_24" app:tint="@android:color/white" android:contentDescription="@string/back" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="20dp"  android:orientation="vertical">
   <TextView android:id="@+id/levelDaysOfWeek4" style="@style/FitTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hard_level" android:textColor="@android:color/white" android:textSize="28sp" android:paddingEnd="80dp" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp"/>
   <TextView style="@style/FitBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/workout_program_length" android:textColor="@android:color/white"/>
  </LinearLayout>
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="-20dp" android:orientation="vertical" android:background="@drawable/workout_sheet">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
 <com.google.android.material.button.MaterialButton android:id="@+id/week1" style="@style/WorkoutWeekButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/workout_week_1" android:textAllCaps="false" android:insetLeft="2dp" android:insetRight="2dp" app:cornerRadius="24dp" android:textColor="@color/fit_primary"/>
<com.google.android.material.button.MaterialButton android:id="@+id/week2" style="@style/WorkoutWeekButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/workout_week_2" android:textAllCaps="false" android:insetLeft="2dp" android:insetRight="2dp" app:cornerRadius="24dp" android:textColor="@color/fit_primary"/>
<com.google.android.material.button.MaterialButton android:id="@+id/week3" style="@style/WorkoutWeekButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/workout_week_3" android:textAllCaps="false" android:insetLeft="2dp" android:insetRight="2dp" app:cornerRadius="24dp" android:textColor="@color/fit_primary"/>
 </LinearLayout>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/listDaysOfWeek" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingHorizontal="16dp" android:paddingBottom="12dp"/>
  <ProgressBar android:id="@+id/prgressStart" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone"/>
 </FrameLayout>
 <com.google.android.material.button.MaterialButton android:id="@+id/continueDay" style="@style/FitButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:text="@string/access_loading" android:enabled="false" app:icon="@drawable/fit_play" app:iconGravity="textStart"/>
 </LinearLayout>
</LinearLayout>
