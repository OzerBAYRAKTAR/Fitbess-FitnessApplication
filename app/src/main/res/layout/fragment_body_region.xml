<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fit_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/discovery_icon_background" android:src="@drawable/ic_arrow_back_aligned_24" android:padding="12dp" android:contentDescription="@string/back" app:tint="@color/fit_text"/>
  <TextView android:id="@+id/screenTitle" style="@style/FitSection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/discovery_choose_region"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/regionPicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
  <ImageView android:id="@+id/bodyMap" android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="280dp" android:paddingEnd="12dp" android:scaleType="fitCenter"/>
  <GridLayout android:id="@+id/regionGrid" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:columnCount="2"/>
 </LinearLayout>
 <TextView android:id="@+id/regionTitle" style="@style/FitTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="26sp"/>

 <ProgressBar android:id="@+id/loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="@string/access_loading"/>
 <LinearLayout android:id="@+id/workoutList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp"/>
 <com.google.android.material.chip.Chip android:id="@+id/warmupChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:checkable="true" android:text="@string/region_warmup" app:chipBackgroundColor="@color/fit_soft" android:textColor="@color/fit_text"/>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
