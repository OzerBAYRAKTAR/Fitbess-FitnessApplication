<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/deleteFavoriteQuestion" style="@style/PcSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/lbl_delete_favourite"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/dialogNoFV" style="@style/PcPeriod" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/no"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/dialogYesFV" style="@style/FitButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:minHeight="48dp" android:text="@string/yes" android:backgroundTint="@color/pc_forest"/>
    </LinearLayout>
</LinearLayout>
